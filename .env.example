# Local (start MongoDB service on Windows): mongodb://127.0.0.1:27017/ghg-compliance
# Atlas (mongodb+srv): if you see querySrv ECONNREFUSED, use quoted URI + URL-encode password ($ -> %24)
# Or in Atlas: Connect → Drivers → "Standard connection string" (non-SRV)
MONGODB_URI=mongodb://127.0.0.1:27017/ghg-compliance
JWT_SECRET=carbon_crunch_jwt_secret_token_mvp_2026_secure
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Shared compliance vault (folder from https://drive.google.com/drive/shared-with-me)
# 1. Open the shared folder → Add shortcut to My Drive (or note Shared drive ID)
# 2. Copy folder URL: https://drive.google.com/drive/folders/FOLDER_ID
NEXT_PUBLIC_GDRIVE_FOLDER_URL=https://drive.google.com/drive/folders/1hzkYdbEXRvlKOhyfMp3Pc3rfijGAoimn
NEXT_PUBLIC_GDRIVE_FOLDER_ID=1hzkYdbEXRvlKOhyfMp3Pc3rfijGAoimn
GDRIVE_FOLDER_URL=https://drive.google.com/drive/folders/1hzkYdbEXRvlKOhyfMp3Pc3rfijGAoimn
GDRIVE_FOLDER_ID=1hzkYdbEXRvlKOhyfMp3Pc3rfijGAoimn
NEXT_PUBLIC_GDRIVE_SHARED_VIEW_URL=https://drive.google.com/drive/Folder-path

# Automatic upload: Google Cloud service account with Drive API enabled.
# Share vault folder https://drive.google.com/drive/folders/1hzkYdbEXRvlKOhyfMp3Pc3rfijGAoimn with the SA email (Editor).
# Client Drive links must be viewable by the SA, or clients can use portal "upload file" (multipart to vault).
GDRIVE_SERVICE_ACCOUNT_CLIENT_EMAIL=your-sa@project.iam.gserviceaccount.com
GDRIVE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# Optional: if the vault root is inside a Google Shared drive
GDRIVE_SHARED_DRIVE_ID=
# Set to false only to disable auto-copy (default: copies when SA credentials exist)
GDRIVE_ENABLE_API_COPY=true
# When service account is missing, dev uploads use .data/compliance-vault (set true in prod only if intended)
GDRIVE_ENABLE_LOCAL_VAULT_FALLBACK=true