MONGODB_URI=mongodb://localhost:27017/ghg-compliance
JWT_SECRET=replace_with_a_random_secret_at_least_32_characters_long
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Shared compliance vault (folder from https://drive.google.com/drive/shared-with-me)
# 1. Open the shared folder → Add shortcut to My Drive (or note Shared drive ID)
# 2. Copy folder URL: https://drive.google.com/drive/folders/FOLDER_ID
NEXT_PUBLIC_GDRIVE_FOLDER_URL=https://drive.google.com/drive/folders/YOUR_VAULT_FOLDER_ID
NEXT_PUBLIC_GDRIVE_FOLDER_ID=YOUR_VAULT_FOLDER_ID
GDRIVE_FOLDER_URL=https://drive.google.com/drive/folder_path
GDRIVE_FOLDER_ID=YOUR_VAULT_FOLDER_ID
NEXT_PUBLIC_GDRIVE_SHARED_VIEW_URL=https://drive.google.com/drive/your_folder-path
GDRIVE_SERVICE_ACCOUNT_CLIENT_EMAIL=your-sa@project.iam.gserviceaccount.com
GDRIVE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GDRIVE_SHARED_DRIVE_ID=
GDRIVE_ENABLE_API_COPY=true
# Optional: allow the destructive demo seed endpoint only when explicitly needed
ENABLE_DATABASE_SEED=false

# First administrator bootstrap (used by npm run admin:create)
ADMIN_NAME=Platform Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace_with_a_strong_password_at_least_12_chars

# Initial client account password for future migration inserts (12+ chars)
CLIENT_INITIAL_PASSWORD=replace_with_a_temporary_password_12_chars_min

# Existing account password maintenance (set only when running account:reset-password)
TARGET_EMAIL=admin@example.com
NEW_PASSWORD=replace_with_a_temporary_password_12_chars_min
